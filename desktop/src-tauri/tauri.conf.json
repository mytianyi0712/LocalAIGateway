{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Gateway",
  "version": "0.2.1-fix2",
  "identifier": "io.github.mytianyi.local-ai-gateway",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Local AI Gateway",
        "width": 560,
        "height": 620,
        "minWidth": 520,
        "minHeight": 580,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "多供应商本地 AI 网关",
    "longDescription": "跨平台的本地 AI 协议网关与路由管理工具。",
    "resources": []
  }
}